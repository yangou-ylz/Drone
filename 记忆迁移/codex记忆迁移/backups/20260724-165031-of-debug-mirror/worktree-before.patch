+class _MetaLabel(QLabel):
+    """小号诊断标签：显示帧计数、帧龄和原始字段，避免把旧值误当实时值。"""
+
+    def __init__(self, parent: QWidget | None = None) -> None:
+        super().__init__("未收到", parent)
+        self.setAlignment(Qt.AlignmentFlag.AlignRight | Qt.AlignmentFlag.AlignVCenter)
+        self.setStyleSheet(
+            "font-family: Consolas, 'Courier New', monospace; font-size: 11px; color:#888;"
+        )
+        self._prefix = "未收到"
+        self._ts = 0.0
+        self._count = 0
+
+    def set_meta(self, prefix: str, ts: float, count: int) -> None:
+        self._prefix = prefix
+        self._ts = ts
+        self._count = count
+        self.refresh(time.monotonic())
+
+    def refresh(self, now: float) -> None:
+        if self._ts <= 0.0:
+            self.setText("未收到")
+            self.setStyleSheet(
+                "font-family: Consolas, 'Courier New', monospace; font-size: 11px; color:#888;"
+            )
+            return
+        age = max(0.0, now - self._ts)
+        color = "#9E9E9E" if age > _SLOW_STALE_S else "#8BC34A"
+        self.setStyleSheet(
+            "font-family: Consolas, 'Courier New', monospace; font-size: 11px;"
+            f" color:{color};"
+        )
+        self.setText(f"{self._prefix} | #{self._count} | {age:.1f}s前")
+
+    def check_stale(self, now: float) -> None:
+        self.refresh(now)
+
+
